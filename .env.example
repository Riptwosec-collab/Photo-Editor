# Optional real providers. The current app defaults to a clearly labeled local rule-based demo.
AI_PROVIDER=local-demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloud AI: server-only. User IDs must be explicitly allowed to spend provider credits.
REPLICATE_API_TOKEN=
AI_ALLOWED_USER_IDS=
# Pin a tested Replicate model version (64-character version ID).
# Background model example: cjwbw/rembg. Inpainting example: andreasjansson/stable-diffusion-inpainting.
REPLICATE_BACKGROUND_VERSION=
REPLICATE_INPAINT_VERSION=
REPLICATE_BACKGROUND_IMAGE_KEY=image
REPLICATE_INPAINT_IMAGE_KEY=image
REPLICATE_INPAINT_MASK_KEY=mask
# Describe the tested provider estimate; do not promise a fixed charge for time-based models.
AI_BACKGROUND_COST_LABEL=
AI_INPAINT_COST_LABEL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Durable AI allowance. Server-only; never use NEXT_PUBLIC for service credentials.
# Shared daily reserved estimate (USD cents) and per-account jobs, reset at 00:00 UTC.
# Leave empty to disable paid jobs. Configure the provider's own spending cap too.
AI_DAILY_BUDGET_CENTS=
AI_DAILY_JOBS_PER_USER=
AI_BACKGROUND_RESERVE_CENTS=
AI_INPAINT_RESERVE_CENTS=
REPLICATE_SELECTION_VERSION=
REPLICATE_SELECTION_IMAGE_KEY=image
REPLICATE_SELECTION_PROMPT_KEY=text_prompt
AI_SELECTION_COST_LABEL=
AI_SELECTION_RESERVE_CENTS=
# Selection provider must return a PNG/JPEG/WebP white-on-black semantic mask.
