# Optional real providers. The current app defaults to a clearly labeled local rule-based demo.
AI_PROVIDER=local-demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Cloud AI: server-only. User IDs must be explicitly allowed to spend provider credits.
REPLICATE_API_TOKEN=
AI_ALLOWED_USER_IDS=
# Pin a tested Replicate model version (64-character version ID).
# Background model example: cjwbw/rembg. Inpainting example: andreasjansson/stable-diffusion-inpainting.
REPLICATE_BACKGROUND_VERSION=
REPLICATE_INPAINT_VERSION=
REPLICATE_BACKGROUND_IMAGE_KEY=image
REPLICATE_INPAINT_IMAGE_KEY=image
REPLICATE_INPAINT_MASK_KEY=mask
# Describe the tested provider estimate; do not promise a fixed charge for time-based models.
AI_BACKGROUND_COST_LABEL=
AI_INPAINT_COST_LABEL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
